{
  "crons": [
    {
      "path": "/api/cron/generate-news",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/generate-trending",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/telegram/api-usage-report?daysAgo=1",
      "schedule": "5 7 * * *"
    },
    {
      "path": "/api/telegram/report?periodo=settimana",
      "schedule": "0 8 * * 1" 
    },
    {
      "path": "/api/telegram/report?periodo=mese",
      "schedule": "0 8 1 * *"
    },
    {
      "path": "/api/telegram/report?periodo=trimestre",
      "schedule": "0 8 1 */3 *"
    },
    {
      "path": "/api/telegram/report?periodo=semestre",
      "schedule": "0 8 1 1,7 *"
    }
  ]
}
